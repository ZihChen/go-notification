{
    "swagger": "2.0",
    "info": {
        "description": "用於管理商戶、玩家和管理員的身份服務",
        "title": "Notification Service API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.jvdiamondtech.com/support",
            "email": "support@jvdiamondtech.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "paths": {
        "/api/v1/merchants/{id}": {
            "get": {
                "description": "根據商戶ID獲取商戶信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "商戶"
                ],
                "summary": "通過ID獲取商戶",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "商戶ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.Merchant"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/message-campaigns": {
            "post": {
                "description": "創建新的會員訊息活動",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "訊息管理"
                ],
                "summary": "創建會員訊息活動",
                "parameters": [
                    {
                        "description": "創建請求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.CreateMessageCampaignRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.MessageCampaign"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/messages/player/{global_player_id}/sse": {
            "get": {
                "description": "為指定玩家建立SSE連接，即時推送訊息更新",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "玩家訊息"
                ],
                "summary": "Server-Sent Events訊息推送",
                "parameters": [
                    {
                        "type": "string",
                        "description": "全域玩家ID",
                        "name": "global_player_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE stream",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "檢查服務是否正常運行",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "系統"
                ],
                "summary": "健康檢查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SuccessResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.CreateMessageCampaignRequest": {
            "type": "object",
            "required": [
                "category",
                "content",
                "created_by",
                "focus",
                "item",
                "title"
            ],
            "properties": {
                "auto_send": {
                    "type": "boolean"
                },
                "category": {
                    "type": "integer",
                    "maximum": 3,
                    "minimum": 1
                },
                "content": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string",
                    "maxLength": 100
                },
                "focus": {
                    "type": "integer"
                },
                "item": {
                    "type": "integer",
                    "maximum": 6,
                    "minimum": 1
                },
                "send_end_time": {
                    "type": "string"
                },
                "send_start_time": {
                    "type": "string"
                },
                "title": {
                    "type": "string",
                    "maxLength": 255
                },
                "total_target_count": {
                    "type": "integer"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "An error occurred"
                }
            }
        },
        "handler.Merchant": {
            "type": "object",
            "properties": {
                "api_key": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "display_name": {
                    "type": "string"
                },
                "global_merchant_id": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "handler.MessageCampaign": {
            "type": "object",
            "properties": {
                "auto_send": {
                    "description": "是否為系統自動訊息",
                    "type": "boolean"
                },
                "category": {
                    "description": "1=member, 2=bonus, 3=others",
                    "type": "integer"
                },
                "content": {
                    "description": "可包含 HTML Tag",
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "created_by": {
                    "description": "建立者帳號或名稱",
                    "type": "string"
                },
                "focus": {
                    "description": "1=_in_thirty, 2=_low_activity, 3=_not_activity, 8=_one, 9=_level, 10=_tag, 11=_all",
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "item": {
                    "description": "1=registration, 2=identity_verification, ..., 6=all",
                    "type": "integer"
                },
                "real_sent_count": {
                    "description": "實際成功發送人數",
                    "type": "integer"
                },
                "send_end_time": {
                    "type": "string"
                },
                "send_start_time": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "total_target_count": {
                    "description": "預估發送對象總人數",
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                },
                "updated_by": {
                    "description": "最後更新者帳號或名稱",
                    "type": "string"
                }
            }
        },
        "handler.SuccessResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        }
    }
}