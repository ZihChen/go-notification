        "/api/v1/message-campaigns": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "分頁列出會員訊息活動",
                "tags": [
                    "會員訊息活動"
                ],
                "summary": "列出會員訊息活動",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "頁碼",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每頁數量",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "是否包含已刪除的活動",
                        "name": "include_deleted",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "collectionFormat": "csv",
                        "description": "狀態篩選 (1=草稿, 2=已排程, 3=已發送, 4=已取消)",
